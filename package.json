{
  "name": "@zihanw/pi-subagent-runtime",
  "version": "0.0.0",
  "description": "Pure execution kernel for caller-prepared Pi agents.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./backends/subprocess": {
      "types": "./dist/backends/subprocess/index.d.ts",
      "import": "./dist/backends/subprocess/index.js",
      "default": "./dist/backends/subprocess/index.js"
    },
    "./backends/rpc": {
      "types": "./dist/backends/rpc/index.d.ts",
      "import": "./dist/backends/rpc/index.js",
      "default": "./dist/backends/rpc/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "VISION.md",
    "LICENSE*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "verify": "npm test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "22.20.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
